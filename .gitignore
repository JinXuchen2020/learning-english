# ============================================================================
# learning-english — root .gitignore (covers Next.js frontend in src/ and
# NestJS backend in server/, plus project-specific artifacts)
# ============================================================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Build outputs ---
.next/
out/
dist/
build/
build.log
tsconfig.tsbuildinfo
*.tsbuildinfo

# --- Environment & secrets (NEVER commit real keys) ---
.env
.env.local
.env.*.local
.env.production
!.env.example

# --- Test / coverage ---
coverage/
*.lcov

# --- Databases ---
*.sqlite
*.sqlite3
*.db

# --- Runtime uploads / generated content ---
uploads/
outputs/

# --- Local tooling indexes ---
.codegraph/
.omo/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editor / IDE ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Agent-local data (WorkBuddy: private per-clone, never commit) ---
# 含 memory/、SOUL.md / IDENTITY.md / USER.md / BOOTSTRAP.md 等私有数据
.workbuddy/*
# 但保留项目级 skills/ 跟踪，使 feature-builder 工作流（含质量门 hook 约定）可随仓库复现
!.workbuddy/skills/
