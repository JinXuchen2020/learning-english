# ---------------------------------------------------------------------------
# Database driver switch
# ---------------------------------------------------------------------------
# DB_TYPE controls which database the app connects to:
#   sqlite   -> zero-config local file DB (default, great for development)
#   postgres -> PostgreSQL (recommended for staging / production)
#
# The same entity definitions work for both drivers, so you can flip this
# value and restart to switch seamlessly between them.
DB_TYPE=sqlite

# SQLite settings (used when DB_TYPE=sqlite)
# The database is stored in a single file relative to the server/ directory.
SQLITE_PATH=dev.sqlite

# PostgreSQL settings (used when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=kids_english

# Auto-create/update schema from entities. Convenient in dev; set to false
# and use TypeORM migrations in production.
DB_SYNCHRONIZE=true

# JWT
JWT_SECRET=fox-english-kids-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# App
PORT=4000

# ---------------------------------------------------------------------------
# AI Provider (Zhipu BigModel) — 系统默认经 seed 注入数据库 (AI-713)
# ---------------------------------------------------------------------------
# 运行时不再从 env 读取任何 AI provider 配置。运行 `npm run seed` 时，下方
# ZHIPU_API_KEY 会被加密写入 provider_configs 表（ownerUserId=NULL, isDefault=true）
# 作为系统默认 provider。家长未设置自己的 provider 时全局复用此默认。
# 仅 seed 阶段需要本变量；运行期 AI 调用一律走数据库中的系统默认配置。
ZHIPU_API_KEY=replace-with-your-zhipu-key

# AES-256-GCM 加密密钥（加密 provider apiKey 落库）。seed 与运行期必须一致；生产必填。
PROVIDER_ENC_KEY=replace-with-a-32-byte-hex-key

# ---------------------------------------------------------------------------
# AI daily quota (AI-107) — per-user daily call count / token usage cap
# ---------------------------------------------------------------------------
# Set small values locally to verify the 429 trigger; production uses defaults
# (200 calls / 100000 tokens) when these are unset or invalid.
AI_DAILY_CALL_LIMIT=200
AI_DAILY_TOKEN_LIMIT=100000
