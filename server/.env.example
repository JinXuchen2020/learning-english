# ---------------------------------------------------------------------------
# Database driver switch
# ---------------------------------------------------------------------------
# DB_TYPE controls which database the app connects to:
#   sqlite   -> zero-config local file DB (default, great for development)
#   postgres -> PostgreSQL (recommended for staging / production)
#
# The same entity definitions work for both drivers, so you can flip this
# value and restart to switch seamlessly between them.
DB_TYPE=sqlite

# SQLite settings (used when DB_TYPE=sqlite)
# The database is stored in a single file relative to the server/ directory.
SQLITE_PATH=dev.sqlite

# PostgreSQL settings (used when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=kids_english

# Auto-create/update schema from entities. Convenient in dev; set to false
# and use TypeORM migrations in production.
DB_SYNCHRONIZE=true

# JWT
JWT_SECRET=fox-english-kids-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# App
PORT=4000

# ---------------------------------------------------------------------------
# AI Provider (Zhipu BigModel, OpenAI-compatible) — ACTIVE default
# ---------------------------------------------------------------------------
# AI_PROVIDER selects the AI backend:
#   bigmodel -> Zhipu BigModel open.bigmodel.cn (GLM 系列, OpenAI 兼容)
#   nvidia   -> NVIDIA build.nvidia.com (需要账户开通模型推理权限)
#   mock     -> deterministic fake data (no API key needed, for dev/test)
AI_PROVIDER=bigmodel

# BigModel API key, format: {id}.{secret} (from bigmodel.cn)
BIGMODEL_API_KEY=replace-with-your-bigmodel-key

# OpenAI-compatible base URL + default chat model.
# NOTE: glm-4.7-flash is a REASONING model: it emits `reasoning_content` first,
# so `max_tokens` must be large enough (>=512) and HTTP timeout generous (>=60s).
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
BIGMODEL_MODEL=glm-4.7-flash

# Vision / OCR model (multimodal) — photo-word learning, handwritten OCR, etc.
# NOTE: free-tier model, frequently rate-limited (429 error code 1305), so the
# provider must retry with backoff; treat 429 as a transient error (AI-106).
BIGMODEL_VISION_MODEL=glm-4.6v-flash

# ---------------------------------------------------------------------------
# AI Provider (NVIDIA NIM / build.nvidia.com, OpenAI-compatible) — BACKUP
# NOTE: the key must have model inference access on its NVIDIA account,
# otherwise requests return "404 Function not found for account ..." or hang.
# ---------------------------------------------------------------------------
# AI_PROVIDER=nvidia
# NVIDIA_API_KEY=replace-with-your-nvapi-key
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Optional: content-safety filter model used by the conversation safety layer (AI-406)
# NVIDIA_SAFETY_MODEL=nvidia/llama-3.1-nemoguard-8b-content-safety
