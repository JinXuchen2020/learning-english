{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "env": {
    "DB_TYPE": "postgres",
    "AI_PROVIDER": "mock",
    "LOG_DIR": "/tmp/logs",
    "EMAIL_LOG_DIR": "/tmp/emails",
    "FRONTEND_ORIGIN": "https://learning-english-ui.vercel.app"
  }
}
